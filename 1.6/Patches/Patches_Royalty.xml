<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Imperial settlements (Royalty): the Empire's settlement trader kind. An
       ultratech society is the one ground faction that plausibly keeps
       xenogerms on the shelf, so it ships at the orbital exotic trader's range.
       Trading there still needs the Trade Settlement permit, as vanilla
       requires. Wrapped in FindMod because the def only exists with Royalty
       active and an unmatched xpath is a patch error. FindMod matches mod
       names; an expansion's is its ExpansionDef label ("Royalty" - its
       About.xml carries no <name>), not its packageId. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Royalty</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/TraderKindDef[defName="Base_Empire_Standard"]/stockGenerators</xpath>
      <value>
        <li Class="XenogermTraderStock.StockGenerator_Xenogerms">
          <countRange>0~2</countRange>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
