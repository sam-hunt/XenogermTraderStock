<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Xenogerms as quest rewards and world loot: ThingSetMaker_Xenogerms added
       as one option to vanilla pools that already carry genepacks. The weight
       here is a placeholder that only keeps the option in the roll: the maker
       supplies the real one, a genepack's own weight in the same pool times
       the commonality setting (its header has the detail). Both settings ship
       at 0%, so nothing appears until a player turns one up.

       Each operation is conditional on the exact node it adds to and names the
       class it expects there, never a position. With the pool's expansion
       inactive, or another mod having reshaped the pool, it does nothing and
       logs nothing. A conditional rather than PatchOperationFindMod because
       that one compares an expansion's translated label, which stops matching
       on a mid-session reload in several languages. -->

  <!-- Standard item rewards: quests, plus peace talks, item stashes and refugee
       rewards, which roll the same def. The option with maxMarketValue is the
       real reward list; its sibling is the gold and plasteel filler. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingSetMakerDef[defName="Reward_ItemsStandard"]/root/options/li[maxMarketValue]/thingSetMaker[@Class="ThingSetMaker_RandomOption"]/options</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingSetMakerDef[defName="Reward_ItemsStandard"]/root/options/li[maxMarketValue]/thingSetMaker[@Class="ThingSetMaker_RandomOption"]/options</xpath>
      <value>
        <li>
          <weight>1</weight>
          <thingSetMaker Class="XenogermTraderStock.ThingSetMaker_Xenogerms">
            <channel>QuestReward</channel>
          </thingSetMaker>
        </li>
      </value>
    </match>
  </Operation>

  <!-- Ancient complex loot rooms (Ideology). -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingSetMakerDef[defName="MapGen_AncientComplexRoomLoot_Better"]/root[@Class="ThingSetMaker_RandomOption"]/options</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingSetMakerDef[defName="MapGen_AncientComplexRoomLoot_Better"]/root[@Class="ThingSetMaker_RandomOption"]/options</xpath>
      <value>
        <li>
          <weight>1</weight>
          <thingSetMaker Class="XenogermTraderStock.ThingSetMaker_Xenogerms">
            <channel>WorldLoot</channel>
          </thingSetMaker>
        </li>
      </value>
    </match>
  </Operation>

  <!-- Sealed crates and rusted safes (Odyssey). -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingSetMakerDef[defName="MapGen_HighValueCrate"]/root[@Class="ThingSetMaker_RandomOption"]/options</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingSetMakerDef[defName="MapGen_HighValueCrate"]/root[@Class="ThingSetMaker_RandomOption"]/options</xpath>
      <value>
        <li>
          <weight>1</weight>
          <thingSetMaker Class="XenogermTraderStock.ThingSetMaker_Xenogerms">
            <channel>WorldLoot</channel>
          </thingSetMaker>
        </li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingSetMakerDef[defName="Reward_AncientSafe"]/root[@Class="ThingSetMaker_RandomOption"]/options</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingSetMakerDef[defName="Reward_AncientSafe"]/root[@Class="ThingSetMaker_RandomOption"]/options</xpath>
      <value>
        <li>
          <weight>1</weight>
          <thingSetMaker Class="XenogermTraderStock.ThingSetMaker_Xenogerms">
            <channel>WorldLoot</channel>
          </thingSetMaker>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
