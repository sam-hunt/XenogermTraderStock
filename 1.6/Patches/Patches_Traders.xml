<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Add xenogerm stock generator to Exotic Goods orbital trader -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="Orbital_Exotic"]/stockGenerators</xpath>
    <value>
      <li Class="XenogermTraderStock.StockGenerator_Xenogerms">
        <countRange>0~2</countRange>
      </li>
    </value>
  </Operation>

  <!-- Add xenogerm stock generator to the Exotic Goods ground caravan: a rarer
       find than the orbital trader, hence the lower ceiling. Each countRange
       here is that trader's SHIPPED DEFAULT - the settings' per-trader stock
       quantity overrides fall back to it when unset. -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="Caravan_Outlander_Exotic"]/stockGenerators</xpath>
    <value>
      <li Class="XenogermTraderStock.StockGenerator_Xenogerms">
        <countRange>0~1</countRange>
      </li>
    </value>
  </Operation>

  <!-- Outlander settlements (every faction whose baseTraderKinds names this
       kind: the civil and rough unions, plus modded factions reusing it).
       Opt-in: an industrial-tech town has no business stocking xenogerms, so
       the shipped default rolls none and the settings row is the lever for
       players who want them. Patching the kind still makes those settlements
       BUY xenogerms, so there is somewhere on the ground to sell one. -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/TraderKindDef[defName="Base_Outlander_Standard"]/stockGenerators</xpath>
    <value>
      <li Class="XenogermTraderStock.StockGenerator_Xenogerms">
        <countRange>0~0</countRange>
      </li>
    </value>
  </Operation>
</Patch>